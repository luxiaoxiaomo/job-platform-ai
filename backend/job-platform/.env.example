# 环境变量配置文件（模板）
# 复制此文件为 .env 并填入实际配置

# === 基础配置 ===
ENV=dev
DEBUG=true
SECRET_KEY=your-secret-key-change-in-production

# === 数据库配置 ===
DATABASE_URL=postgresql+asyncpg://dev:dev123@localhost:5432/jobplatform_dev
# 测试数据库（必须包含_test后缀）
TEST_DATABASE_URL=postgresql+asyncpg://dev:dev123@localhost:5432/jobplatform_test
DATABASE_ECHO=false

# === Redis配置 ===
REDIS_URL=redis://localhost:6379/0

# === AI服务配置 ===
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
QWEN_API_KEY=sk-your-qwen-api-key

# === JWT配置 ===
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120

# === 手机号哈希密钥（独立于JWT） ===
# 用于手机号的确定性哈希，不要与JWT_SECRET_KEY相同
# 生成方法：python -c "import secrets; print(secrets.token_urlsafe(32))"
PHONE_HASH_SECRET=your-phone-hash-secret-change-in-production

# === 字段加密配置 ===
# 用于加密敏感字段（手机号、真实姓名等）
# 生成方法：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-32-byte-encryption-key-change-in-production

# === CORS配置 ===
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8080","http://127.0.0.1:3000","http://127.0.0.1:8080"]

# === 文件上传配置 ===
MAX_UPLOAD_SIZE=10485760

# === OCR configuration ===
# mock/rapidocr
OCR_PROVIDER=mock
OCR_CONFIDENCE_THRESHOLD=0.5
OCR_PDF_MAX_PAGES=3
OCR_PDF_RENDER_SCALE=2.0

# === Celery配置 ===
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# === OCR服务（可选） ===
# BAIDU_OCR_API_KEY=
# BAIDU_OCR_SECRET_KEY=

# === 微信配置（可选） ===
# WECHAT_APP_ID=
# WECHAT_APP_SECRET=

# === 对象存储（可选） ===
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# OSS_BUCKET=
# OSS_ENDPOINT=
